///         Deploying this contract installs that runtime, which answers to `poseidon(bytes32[2])`
///         (selectors 0x299e5660) and reduces each input modulo the field like circomlibjs.
///         Runtime: 13952 bytes, 11368 gas per call inside the callee (data-independent).
contract PoseidonT3BLS12381 {
    bytes internal constant RUNTIME =
        hex"";

    constructor() {
        bytes memory code = RUNTIME;
        assembly {
            return(add(code, 0x20), mload(code))
